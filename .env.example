# Kopiere diese Datei zu ".env" und trage die Werte aus dem Supabase-Dashboard ein
# (Project Settings → API). Die Datei ".env" kommt nie ins Repository.
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=DEIN-ANON-SCHLUESSEL
# NIEMALS den "service_role"-Schlüssel hier eintragen.
# Nur für Mitteilungen (Web-Push): der ÖFFENTLICHE Schlüssel aus "npm run vapid". Ohne ihn bleibt die Funktion in der App ausgeschaltet.
VITE_VAPID_PUBLIC_KEY=
